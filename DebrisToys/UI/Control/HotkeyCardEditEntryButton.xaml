<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DebrisToys.UI.Control"
                    xmlns:shkui="using:ShimizuToolkit.HotkeyWinUI.Controls">
    <Style TargetType="local:HotkeyCardEditEntryButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HotkeyCardEditEntryButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Button x:Name="PART_BaseButton"
                                Style="{ThemeResource SubtleButtonStyle}">
                            <Grid>
                                <StackPanel x:Name="PART_HotkeyNotEmptyPresenter"
                                            Orientation="Horizontal">
                                    <Viewbox Height="32">
                                        <shkui:KeyBlockPanel x:Name="PART_KeyBlockPresenter"
                                                             IsHitTestVisible="False" />
                                    </Viewbox>
                                    <FontIcon Glyph="&#xE70F;"
                                              FontSize="14" />
                                </StackPanel>
                                <StackPanel x:Name="PART_HotkeyEmptyPresenter"
                                            Orientation="Horizontal">
                                    <TextBlock x:Uid="DebrisToys_UI_Control_HotkeyCardEditEntryButton_PART_HotkeyEmptyPresenter_PlaceHolderText" />
                                    <FontIcon Glyph="&#xE710;" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
