<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DebrisToys.UI.Window.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TrayWindow">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <RelativePanel Background="Transparent">
        <RelativePanel x:Name="TopOptionBar"
                       RelativePanel.AlignLeftWithPanel="True"
                       RelativePanel.AlignTopWithPanel="True"
                       RelativePanel.AlignRightWithPanel="True"
                       Height="64"
                       Padding="8"
                       Background="Transparent">
            <AppBarButton x:Name="SettingsButton"
                          Icon="Setting"
                          Height="48"
                          Width="40"
                          Padding="0 0 0 0"
                          RelativePanel.AlignTopWithPanel="True"
                          RelativePanel.AlignRightWithPanel="True"
                          RelativePanel.AlignBottomWithPanel="True"
                          Click="SettingsButton_Click" />
        </RelativePanel>
        <Grid RelativePanel.AlignLeftWithPanel="True"
              RelativePanel.Below="TopOptionBar"
              RelativePanel.AlignRightWithPanel="True"
              RelativePanel.AlignBottomWithPanel="True">
            <Rectangle HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       Opacity="90" />
            <StackPanel Padding="16 32 16 0">
                <Grid VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Hide Taskbar"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </RelativePanel>
</Window>
